{
	"version": 1,
	"base_image": "codeocean/jupyterlab:3.6.1-miniconda4.12.0-python3.9-ubuntu20.04",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true
	},
	"installers": {
		"pip": {
			"packages": [
				{
					"name": "allensdk",
					"version": "2.16.2"
				},
				{
					"name": "dynamax[notebooks]",
					"version": "0.1.5"
				},
				{
					"name": "ipywidgets",
					"version": "8.1.5"
				},
				{
					"name": "jax[cpu]",
					"version": "0.4.23"
				},
				{
					"name": "numpy",
					"version": "1.23.4"
				},
				{
					"name": "scikit-learn",
					"version": "1.3.0"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	},
	"env_variables": [
		{
			"name": "PYTHONPATH",
			"value": "\"${PYTHONPATH}:/root/capsule/code\""
		}
	]
}